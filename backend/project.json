{
  "name": "backend",
  "sourceRoot": "backend/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn -f backend/pom.xml clean package -DskipTests"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn -f backend/pom.xml clean test"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn -f backend/pom.xml spring-boot:run"
      }
    }
  }
}
